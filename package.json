{
  "name": "ais-its-contracts-workspace",
  "version": "0.2.0",
  "private": true,
  "description": "Shared libraries of AIS Maritime Intelligence v2: @darmawanweb/ais-its-contracts (isomorphic contracts) and @darmawanweb/ais-its-nest (NestJS service kit with the Detector SDK).",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean",
    "schemas": "pnpm -r --if-present schemas",
    "schemas:check": "pnpm -r --if-present schemas:check",
    "references:sync": "pnpm --filter @darmawanweb/ais-its-contracts run references:sync",
    "references:check": "pnpm --filter @darmawanweb/ais-its-contracts run references:check",
    "check:package": "pnpm -r --if-present check:package",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
