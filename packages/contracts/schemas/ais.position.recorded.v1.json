{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seemp.dev/schemas/events/ais.position.recorded.v1.json",
  "title": "AisPositionRecordedV1",
  "description": "Payload (\"data\") of ais.position.recorded.v1. A position recorded by the ais-processor, enriched with predicted navstatus, EWS status and distances, plus the previous position of the vessel.",
  "type": "object",
  "properties": {
    "mmsi": {
      "type": "integer",
      "minimum": 100000000,
      "maximum": 999999999,
      "description": "Maritime Mobile Service Identity (9 digits)"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "Position time"
    },
    "source": {
      "type": "string",
      "enum": ["primary", "batam", "pusher"],
      "description": "AIS feed the message came from"
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "description": "WGS84 latitude in degrees"
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "description": "WGS84 longitude in degrees"
    },
    "sog": {
      "type": "number",
      "minimum": 0,
      "maximum": 102.3,
      "description": "Speed over ground in knots (102.3 = not available)"
    },
    "cog": {
      "type": "number",
      "minimum": 0,
      "maximum": 360,
      "description": "Course over ground in degrees (360 = not available)"
    },
    "hdg": {
      "anyOf": [
        { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        { "type": "number", "const": 511 }
      ],
      "description": "True heading in degrees 0..359 (511 = not available)"
    },
    "navstatus": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15,
      "description": "AIS navigational status 0..15"
    },
    "predictedNavstatus": {
      "anyOf": [
        { "type": "number", "const": 0 },
        { "type": "number", "const": 1 }
      ],
      "description": "Predicted navigational status: 1 = at anchor, 0 = not at anchor"
    },
    "ewsStatus": {
      "anyOf": [
        { "type": "number", "const": 0 },
        { "type": "number", "const": 1 },
        { "type": "number", "const": 3 }
      ],
      "description": "Pipeline EWS status: 0 danger, 1 warning, 3 safe"
    },
    "coastDistanceM": {
      "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }],
      "description": "Distance to the Indonesian coastline in meters"
    },
    "pipelineDistanceM": {
      "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }],
      "description": "Distance to the nearest pipeline in meters"
    },
    "previous": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "time": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "ISO-8601 UTC timestamp, e.g. 2026-11-20T08:30:00.000Z"
            },
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90,
              "description": "WGS84 latitude in degrees"
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180,
              "description": "WGS84 longitude in degrees"
            },
            "sog": {
              "type": "number",
              "minimum": 0,
              "maximum": 102.3,
              "description": "Speed over ground in knots (102.3 = not available)"
            },
            "cog": {
              "type": "number",
              "minimum": 0,
              "maximum": 360,
              "description": "Course over ground in degrees (360 = not available)"
            },
            "hdg": {
              "anyOf": [
                { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
                { "type": "number", "const": 511 }
              ],
              "description": "True heading in degrees 0..359 (511 = not available)"
            },
            "navstatus": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15,
              "description": "AIS navigational status 0..15"
            },
            "predictedNavstatus": {
              "anyOf": [
                { "type": "number", "const": 0 },
                { "type": "number", "const": 1 }
              ],
              "description": "Predicted navigational status: 1 = at anchor, 0 = not at anchor"
            }
          },
          "required": [
            "time",
            "lat",
            "lon",
            "sog",
            "cog",
            "hdg",
            "navstatus",
            "predictedNavstatus"
          ],
          "description": "Last recorded position of the vessel before this one"
        },
        { "type": "null" }
      ]
    }
  },
  "required": [
    "mmsi",
    "time",
    "source",
    "lat",
    "lon",
    "sog",
    "cog",
    "hdg",
    "navstatus",
    "predictedNavstatus",
    "ewsStatus",
    "coastDistanceM",
    "pipelineDistanceM",
    "previous"
  ]
}
