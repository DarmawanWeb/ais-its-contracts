{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seemp.dev/schemas/events/ais.raw.received.v1.json",
  "title": "AisRawReceivedV1",
  "description": "Payload (\"data\") of ais.raw.received.v1. A validated, normalized AIS position report from a feed.",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": ["primary", "batam", "pusher"],
      "description": "AIS feed the message came from"
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "When the ingestor received it"
    },
    "positionTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "Position time (legacy: timestamp - utc seconds)"
    },
    "mmsi": {
      "type": "integer",
      "minimum": 100000000,
      "maximum": 999999999,
      "description": "Maritime Mobile Service Identity (9 digits)"
    },
    "navstatus": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15,
      "description": "AIS navigational status 0..15"
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "description": "WGS84 latitude in degrees"
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "description": "WGS84 longitude in degrees"
    },
    "sog": {
      "type": "number",
      "minimum": 0,
      "maximum": 102.3,
      "description": "Speed over ground in knots (102.3 = not available)"
    },
    "cog": {
      "type": "number",
      "minimum": 0,
      "maximum": 360,
      "description": "Course over ground in degrees (360 = not available)"
    },
    "hdg": {
      "anyOf": [
        { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        { "type": "number", "const": 511 }
      ],
      "description": "True heading in degrees 0..359 (511 = not available)"
    },
    "aisType": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        { "type": "null" }
      ],
      "description": "AIS message type (1-3 class A, 18/19 class B)"
    },
    "receiverPort": {
      "description": "Receiver port reported by the upstream",
      "type": ["string", "null"]
    }
  },
  "required": [
    "source",
    "receivedAt",
    "positionTime",
    "mmsi",
    "navstatus",
    "lat",
    "lon",
    "sog",
    "cog",
    "hdg",
    "aisType",
    "receiverPort"
  ]
}
