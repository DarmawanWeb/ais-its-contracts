{
  "name": "@darmawanweb/ais-its-nest",
  "version": "0.2.0",
  "description": "NestJS 12 service kit of AIS Maritime Intelligence: configuration, logging, HTTP bootstrap and problem details, PostgreSQL + migrations, NATS JetStream publishing and consumers, Valkey, auth guards, audit, health, metrics, tracing, the Detector SDK and test helpers.",
  "keywords": [
    "ais",
    "ais-its",
    "maritime-intelligence",
    "nestjs",
    "fastify",
    "nats",
    "jetstream",
    "postgres",
    "timescaledb",
    "postgis",
    "detectors"
  ],
  "license": "UNLICENSED",
  "author": "DarmawanWeb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarmawanWeb/ais-its-contracts.git",
    "directory": "packages/nest"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./nats": {
      "types": "./dist/nats/index.d.ts",
      "default": "./dist/nats/index.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "default": "./dist/redis/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "default": "./dist/audit/index.js"
    },
    "./health": {
      "types": "./dist/health/index.d.ts",
      "default": "./dist/health/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "default": "./dist/metrics/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "default": "./dist/telemetry/index.js"
    },
    "./internal-http": {
      "types": "./dist/internal-http/index.d.ts",
      "default": "./dist/internal-http/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "default": "./dist/analytics/index.js"
    },
    "./internal": {
      "types": "./dist/internal/index.d.ts",
      "default": "./dist/internal/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/__fixtures__",
    "!dist/.tsbuildinfo",
    "src",
    "!src/**/*.spec.ts",
    "!src/**/__fixtures__",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "clean": "node -e \"for (const p of ['dist', 'coverage']) require('node:fs').rmSync(p, { recursive: true, force: true })\"",
    "check:package": "node scripts/smoke-dist.mjs && publint --strict && attw --pack . --profile esm-only && node scripts/api-report.mjs --check",
    "api:report": "node scripts/api-report.mjs",
    "check:readme": "node scripts/readme-example.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@darmawanweb/ais-its-contracts": "workspace:^",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/otel": "^1.0.1",
    "@fastify/static": "^10.1.12",
    "@nats-io/jetstream": "^3.5.0",
    "@nats-io/transport-node": "^3.5.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-ioredis": "^0.73.0",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-undici": "^0.35.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@types/pg": "^8.23.1",
    "flatbush": "^4.7.0",
    "import-in-the-middle": "^3.6.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.18",
    "lru-cache": "^11.5.3",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-fastify": "^12.5.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/terminus": "^12.2.0",
    "@nestjs/testing": "^12.5.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "testcontainers": "^12.2.2"
  },
  "peerDependenciesMeta": {
    "@nestjs/testing": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    },
    "testcontainers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-fastify": "^12.5.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/terminus": "^12.2.0",
    "@nestjs/testing": "^12.5.1",
    "@swc/core": "^1.16.22",
    "@turf/distance": "7.2.0",
    "@turf/helpers": "7.2.0",
    "@turf/nearest-point-on-line": "7.2.0",
    "@types/node": "^24.19.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pino-pretty": "^13.2.0",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "testcontainers": "^12.2.2",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  },
  "homepage": "https://github.com/DarmawanWeb/ais-its-contracts/tree/main/packages/nest#readme",
  "bugs": {
    "url": "https://github.com/DarmawanWeb/ais-its-contracts/issues"
  }
}
