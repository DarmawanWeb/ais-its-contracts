{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node.js only (NestJS, Fastify, pg, NATS): Node types, ESM output via tsc.
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "incremental": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts", "src/**/__fixtures__/**"]
}
